{
  "$schema": "chronoshft.config_fragment.v3",
  "fragment": "live",
  "version": 1,
  "_comment": "200 USDT Futures-equity RPI calibration canary. Before use: copy this directory outside the repository, replace every EDIT-ME value and the EDITMEUSDT symbol in both live.*.json files and both state fragments, and paste the public signer entry from create_rpi_calibration_permit.py generate-key into calibration_permit_trusted_signers. API keys are read only from the environment variables named here; never put key values in JSON.",
  "api_key_env": "BINANCE_API_KEY",
  "api_secret_env": "BINANCE_API_SECRET",
  "live_launch": {
    "stage": "rpi_calibration_canary",
    "deployment_id": "EDIT-ME-rpi-200u-001",
    "declared_account_equity_usdt": 200.0,
    "max_deployed_capital_usdt": 8.0,
    "max_deployment_loss_usdt": 0.4,
    "deployment_loss_reduce_only_fraction": 0.8,
    "rpi_only": true,
    "calibration_permit_path": "rpi-calibration.permit.json",
    "target_deployment_config_path": "canary.json",
    "calibration_permit_trusted_signers": {},
    "offline_evidence_path": "rpi-calibration.evidence.json"
  },
  "alert": {
    "active": true,
    "transport": "https_webhook",
    "webhook_url_env": "CHRONOSHFT_ALERT_WEBHOOK_URL",
    "minimum_level": "WARNING",
    "queue_capacity": 128,
    "connect_timeout_sec": 1.0,
    "read_timeout_sec": 2.0,
    "max_attempts": 3,
    "retry_backoff_sec": 0.5,
    "startup_probe_required": true,
    "startup_probe_timeout_sec": 12.0,
    "runtime_fail_closed": true,
    "recovery_probe_interval_sec": 30.0,
    "shutdown_flush_timeout_sec": 3.0,
    "failure_spool_path": "storage/live/EDIT-ME-rpi-200u-001/calibration/external_alert_failures.jsonl",
    "failure_spool_fsync": true,
    "failure_spool_min_free_bytes": 536870912
  },
  "system": {
    "evidence_recorder": {
      "enabled": true,
      "path": "storage/live/EDIT-ME-rpi-200u-001/calibration/market_evidence.jsonl",
      "queue_capacity": 8192,
      "max_batch_records": 256,
      "fsync_interval_sec": 1.0,
      "close_timeout_sec": 15.0,
      "min_free_bytes": 536870912,
      "single_writer_fence": {
        "enabled": true,
        "path": "storage/live/EDIT-ME-rpi-200u-001/calibration/market_evidence.jsonl.lock"
      }
    }
  },
  "account": {
    "configuration_mode": "VERIFY_ONLY",
    "trading_budget_total": 8.0,
    "trading_budget_by_asset": {
      "USDT": 8.0
    }
  },
  "oms": {
    "journal_enabled": true,
    "replay_journal_on_startup": true,
    "journal_fsync": true,
    "journal_integrity_check": true,
    "max_total_active_orders": 1,
    "max_symbol_active_orders": 1,
    "max_strategy_active_orders": 1,
    "max_strategy_symbol_active_orders": 1,
    "journal_path": "storage/live/EDIT-ME-rpi-200u-001/calibration/oms_journal.jsonl",
    "truth_monitor": {
      "rpi_commission_poll_interval_sec": 30.0,
      "rpi_commission_halt_threshold": 2,
      "rpi_commission_clean_polls_to_clear": 2
    },
    "single_writer_fence": {
      "enabled": true,
      "path": "storage/live/EDIT-ME-rpi-200u-001/calibration/oms_journal.jsonl.lock"
    },
    "venue_dead_man_switch": {
      "enabled": true
    }
  },
  "risk": {
    "limits": {
      "max_order_notional": 8.0,
      "max_pos_notional": 8.0,
      "max_account_gross_notional": 8.0,
      "max_daily_loss": 0.2
    },
    "market_data_freshness": {
      "enabled": true,
      "require_mark_price": true,
      "require_book": true,
      "max_mark_age_ms": 3000.0,
      "max_book_age_ms": 1500.0
    },
    "funding_guard": {
      "enabled": true,
      "require_snapshot": true,
      "max_snapshot_age_ms": 3000.0,
      "pre_funding_reduce_only_sec": 600.0,
      "post_funding_hold_sec": 120.0,
      "max_abs_funding_rate": 0.0005,
      "max_next_funding_horizon_sec": 32400.0,
      "recovery_updates": 5
    },
    "margin_health": {
      "enabled": true,
      "require_snapshot": true,
      "max_snapshot_age_sec": 15.0
    },
    "independent_supervisor": {
      "api_key_env": "BINANCE_RISK_API_KEY",
      "api_secret_env": "BINANCE_RISK_API_SECRET",
      "flatten_enabled": true,
      "daily_loss_enabled": true,
      "clock_sync_enabled": true,
      "liquidation_proximity_enabled": true,
      "require_liquidation_price": true,
      "max_open_orders": 1
    },
    "cash_flow_truth": {
      "enabled": true,
      "require_snapshot": true,
      "max_snapshot_age_sec": 45.0
    },
    "risk_control_heartbeat": {
      "enabled": true,
      "required_source": "independent_supervisor",
      "max_age_sec": 2.0
    },
    "strategy_risk_budgets": {
      "enabled": true,
      "require_explicit_strategy": true,
      "budgets": {
        "GLFT_MultiScale": {
          "max_gross_notional": 8.0,
          "max_symbol_notional": 8.0
        }
      }
    }
  },
  "strategy": {
    "target_order_notional": 8.0,
    "max_pos_usdt": 8.0,
    "glft": {
      "inventory_lot_notional_usdt": 8.0
    }
  }
}
