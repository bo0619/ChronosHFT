{
  "$schema": "chronoshft.config_fragment.v3",
  "fragment": "paper_trade_database",
  "version": 1,
  "paper_trade_database": {
    "enabled": true,
    "path": "storage/paper/trades.sqlite3",
    "sqlite_timeout_sec": 5.0,
    "queue_capacity": 4096,
    "write_batch_size": 64,
    "min_free_bytes": 536870912,
    "space_check_interval_sec": 1.0,
    "close_timeout_sec": 10.0,
    "strategy_sample_interval_sec": 1.0,
    "account_sample_interval_sec": 1.0,
    "market_sample_interval_sec": 1.0
  }
}
