  "live_enabled": false,
  "secrets_file": "config/local/grvt_secrets.json",
  "log_dir": "storage/live/grvt_maker",
  "kill_file": "storage/live/KILL",
  "cancel_on_disconnect_ms": 5000,
  "reconcile_sec": 30,
  "status_sec": 10,
  "defaults": {
    "quote": {
      "notional": 250.0,
      "half_spread_bps": 0.25,
      "skew_bps_per_lot": 2.5,
      "max_inventory_lots": 1.0,
      "improve": true,
      "keep_ticks": 1.0,
      "min_rest_sec": 1.0,
      "basis_half_life": 60.0
    },
    "risk": {
      "max_position_usd": 250.0,
      "daily_loss_reduce_usd": 5.0,
      "daily_loss_halt_usd": 10.0,
      "stale_binance_sec": 3.0,
      "stale_grvt_sec": 5.0,
      "max_binance_lag_ms": 250.0,
      "max_maker_fee_bps": 0.5,
      "max_actions_per_sec": 20.0,
      "max_consecutive_errors": 5
    }
  },
  "symbols": {
    "ADAUSDT": {
      "quote": {
        "half_spread_bps": 2.0
      }
    },
