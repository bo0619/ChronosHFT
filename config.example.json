{
    "testnet": true,
    "api_key_env": "BINANCE_API_KEY",
    "api_secret_env": "BINANCE_API_SECRET",
    "symbols": ["SOLUSDT"],
    "record_data": true,
    "system": {
        "dry_run": true,
        "log_level": "INFO",
        "log_path": "logs",
        "log_console": false,
        "web_port": 8000,
        "time_sync": {
            "max_offset_ms": 250.0,
            "halt_offset_ms": 1000.0,
            "max_rtt_ms": 1500.0,
            "freeze_breach_threshold": 2,
            "halt_breach_threshold": 2,
            "recovery_success_threshold": 2,
            "sync_interval_sec": 600.0,
            "unhealthy_retry_sec": 15.0,
            "max_consecutive_failures": 3
        },
        "event_engine": {
            "queue_warn_depth": {
                "market": 25,
                "execution": 25,
                "cold": 200
            },
            "backlog_warn_ms": {
                "market": 200,
                "execution": 300,
                "cold": 2000
            },
            "handler_slow_ms": {
                "market": 5,
                "execution": 20,
                "cold": 100
            },
            "degraded_queue_depth": {
                "market": 20,
                "execution": 20
            },
            "passive_only_queue_depth": {
                "market": 50,
                "execution": 50
            },
            "freeze_queue_depth": {
                "market": 100,
                "execution": 100
            },
            "degraded_backlog_ms": {
                "market": 250,
                "execution": 250
            },
            "passive_only_backlog_ms": {
                "market": 600,
                "execution": 600
            },
            "freeze_backlog_ms": {
                "market": 1500,
                "execution": 1500
            },
            "recovery_checks": 20,
            "alert_interval_sec": 5
        },
        "market_data": {
            "publish_depth_levels": 5,
            "emit_full_orderbook_events": false
        },
        "strategy_runtime": {
            "queue_warn_depth": 100,
            "warn_queue_depth": 20,
            "freeze_queue_depth": 80,
            "warn_backlog_ms": 400,
            "freeze_backlog_ms": 1500,
            "alpha_process_warn_deferred": 8,
            "alpha_process_freeze_deferred": 32,
            "recovery_checks": 20,
            "slow_handler_ms": 100,
            "alert_interval_sec": 5,
            "alpha_process": {
                "enabled": true,
                "queue_size": 256,
                "processes": 2,
                "auto_restart": true,
                "restart_cooldown_sec": 2.0,
                "max_restart_burst": 3,
                "restart_window_sec": 30.0,
                "quarantine_sec": 30.0,
                "standby_profile": {
                    "tick_interval_sec": 0.25,
                    "cycle_interval_sec": 2.0
                }
            }
        }
    },
    "alert": {
        "active": true,
        "telegram_token": "",
        "telegram_chat_id": ""
    },
    "account": {
        "leverage": 8,
        "margin_type": "ISOLATED",
        "position_mode": "ONE_WAY",
        "initial_balance_usdt": 100.0,
        "trading_budget_total": 100.0,
        "trading_budget_by_asset": {
            "USDT": 100.0
        }
    },
    "oms": {
        "journal_enabled": true,
        "replay_journal_on_startup": true,
        "journal_path": "storage/oms/oms_journal.jsonl",
        "journal_fsync": true,
        "journal_integrity_check": true,
        "tombstone_max": 2000,
        "ack_timeout_sec": 5.0,
        "unknown_recheck_sec": 1.0,
        "cancel_timeout_sec": 5.0,
        "active_order_audit_interval_sec": 30.0,
        "unknown_order_min_not_found": 3,
        "unknown_order_resolution_timeout_sec": 15.0,
        "trade_recovery_lookback_ms": 86400000,
        "trade_recovery_overlap_ms": 60000,
        "snapshot_stability_required": 2,
        "snapshot_max_attempts": 6,
        "snapshot_settle_interval_sec": 0.25,
        "command_fence_timeout_sec": 5.25,
