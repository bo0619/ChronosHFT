    "backtest": {
        "initial_capital": 100.0,
        "taker_fee": 0.0005,
        "maker_fee": 0.0002,
        "latency_ms_mean": 20,
        "latency_ms_std": 5,
        "cancel_ahead_prob": 0.5
    },
    "chaos": {
        "packet_loss_rate": 0.0,
        "order_reject_rate": 0.0
    },
    "strategy": {
        "name": "ML_Sniper",
        "use_rpi": true,        
        "_comment_capital_scaling": "Only change capital_multiplier. Order notional and caps scale together.",
        "capital_multiplier": 1.0,
        "capital_scaling": {
            "enabled": true,
            "reference_capital_usdt": 100.0,
            "target_order_notional": 8.0,
