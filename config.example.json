{
    "execution": {
        "mode": "paper"
    },
    "paper_trade": {
        "_comment": "Production Binance public market data with local-only balances, orders, fills, fees and PnL. No private API credentials are used.",
        "enabled": true,
        "market_data_environment": "production",
        "initial_balance_usdt": 100.0,
        "maker_fee": 0.0002,
        "taker_fee": 0.0005,
        "rpi_commission_rate": 0.0,
        "rpi_commission_rates": {},
        "rpi_fill_model": "disabled",
        "public_trade_proxy": false,
        "reset_on_start": true,
        "cancel_ahead_fraction": 0.0,
        "maintenance_margin_rate": 0.005,
        "command_timeout_sec": 2.0,
        "command_queue_size": 10000
    },
    "testnet": false,
    "api_key_env": "BINANCE_API_KEY",
    "api_secret_env": "BINANCE_API_SECRET",
    "symbols": [
        "BZUSDT",
        "CLUSDT",
        "KORUUSDT",
        "MUUSDT",
        "SKHYNIXUSDT",
        "SKHYUSDT",
        "SNDKUSDT",
        "SOXLUSDT",
        "SOXSUSDT",
        "SPCXUSDT",
        "XAGUSDT",
        "XAUUSDT"
    ],
    "record_data": true,
    "system": {
        "log_level": "INFO",
        "log_path": "logs",
        "log_console": false,
        "web_port": 8000,
        "web_dashboard": {
            "_comment": "Loopback-only read-only monitoring UI. It never exposes API credentials or accepts trading commands.",
            "enabled": true,
            "host": "127.0.0.1",
            "port": 8765,
            "open_browser": true,
            "refresh_interval_ms": 1000,
            "snapshot_stale_after_sec": 2.0,
            "history_limit": 600,
            "orders_limit": 100,
            "trades_limit": 100,
            "logs_limit": 200
        },
        "time_sync": {
            "_comment": "Software HFT clock: Binance multi-sample calibration anchors exchange epoch to perf_counter_ns. Startup and every risk-increasing order fail closed unless healthy.",
            "startup_required": true,
            "require_healthy_for_trading": true,
            "sample_count": 7,
            "min_successful_samples": 4,
            "low_rtt_sample_count": 3,
            "sample_spacing_ms": 10.0,
            "request_timeout_sec": 1.0,
            "connection_warmup_timeout_sec": 3.0,
            "max_initial_offset_ms": 5000.0,
            "max_phase_error_ms": 25.0,
            "halt_phase_error_ms": 100.0,
            "max_rtt_ms": 200.0,
            "max_uncertainty_ms": 50.0,
            "max_offset_dispersion_ms": 10.0,
            "max_sync_age_sec": 30.0,
            "max_wall_clock_step_ms": 20.0,
            "health_poll_interval_sec": 0.1,
            "freeze_breach_threshold": 1,
            "halt_breach_threshold": 2,
            "recovery_success_threshold": 2,
            "sync_interval_sec": 10.0,
            "unhealthy_retry_sec": 1.0,
            "max_consecutive_failures": 2
        },
        "evidence_recorder": {
            "_comment": "Disabled in Paper. Live templates require a deployment-bound hash-chained JSONL recorder and independent writer fence.",
            "enabled": false,
            "path": "",
            "queue_capacity": 8192,
            "max_batch_records": 256,
            "fsync_interval_sec": 1.0,
            "close_timeout_sec": 15.0,
            "single_writer_fence": {
                "enabled": true,
                "path": ""
            }
        },
        "event_engine": {
            "queue_warn_depth": {
                "market": 25,
                "execution": 25,
                "cold": 200
            },
            "backlog_warn_ms": {
                "market": 200,
                "execution": 300,
                "cold": 2000
            },
            "handler_slow_ms": {
                "market": 5,
                "execution": 20,
                "cold": 100
            },
            "degraded_queue_depth": {
                "market": 20,
                "execution": 20
            },
            "passive_only_queue_depth": {
                "market": 50,
                "execution": 50
            },
            "freeze_queue_depth": {
                "market": 100,
                "execution": 100
            },
            "degraded_backlog_ms": {
                "market": 250,
                "execution": 250
            },
            "passive_only_backlog_ms": {
                "market": 600,
                "execution": 600
            },
            "freeze_backlog_ms": {
                "market": 1500,
                "execution": 1500
            },
            "recovery_checks": 20,
            "alert_interval_sec": 5,
            "shutdown_drain_timeout_sec": 5
        },
        "shutdown": {
            "max_attempts": 3,
            "retry_interval_sec": 0.5
        },
        "market_data": {
            "environment": "production",
            "testnet": false,
            "public_only": true,
            "publish_depth_levels": 5,
            "emit_full_orderbook_events": false,
            "max_book_buffer": 50000,
            "book_resync_max_attempts": 3,
            "book_resync_retry_sec": 0.25
        },
        "strategy_runtime": {
            "queue_warn_depth": 100,
            "warn_queue_depth": 20,
            "freeze_queue_depth": 80,
            "warn_backlog_ms": 400,
            "freeze_backlog_ms": 1500,
            "recovery_checks": 20,
            "slow_handler_ms": 100,
            "alert_interval_sec": 5,
            "shutdown_timeout_sec": 5
        }
    },
    "alert": {
        "_comment": "Paper may leave this disabled. Live requires the full bounded HTTPS webhook policy shown in config.live.canary.example.json; never put a webhook URL or provider token in JSON.",
        "active": false,
        "transport": "https_webhook",
        "webhook_url_env": "CHRONOSHFT_ALERT_WEBHOOK_URL"
    },
    "account": {
        "leverage": 8,
        "margin_type": "ISOLATED",
        "position_mode": "ONE_WAY",
        "initial_balance_usdt": 100.0,
        "trading_budget_total": 100.0,
        "trading_budget_by_asset": {
            "USDT": 100.0
        }
    },
    "oms": {
        "journal_enabled": true,
        "replay_journal_on_startup": false,
        "journal_path": "storage/paper/oms_journal.jsonl",
        "journal_fsync": true,
        "journal_integrity_check": true,
        "tombstone_max": 2000,
        "ack_timeout_sec": 5.0,
        "unknown_recheck_sec": 1.0,
        "cancel_timeout_sec": 5.0,
        "active_order_audit_interval_sec": 30.0,
        "unknown_order_min_not_found": 3,
        "unknown_order_resolution_timeout_sec": 15.0,
        "trade_recovery_lookback_ms": 86400000,
        "trade_recovery_overlap_ms": 60000,
        "trade_recovery_id_overlap": 100,
        "trade_tail_verification_delay_sec": 0.25,
        "trade_tail_verification_retry_sec": 0.5,
        "trade_tail_verification_attempts": 4,
        "snapshot_stability_required": 2,
        "snapshot_max_attempts": 6,
        "snapshot_settle_interval_sec": 0.25,
        "command_fence_timeout_sec": 0.0,
        "outbound_gate_drain_timeout_sec": 10.0,
        "shutdown_cancel_timeout_sec": 30.0,
        "shutdown_empty_snapshots_required": 2,
        "shutdown_cancel_settle_interval_sec": 0.25,
        "outbound_message_budget": {
            "enabled": true,
            "window_sec": 1.0,
            "max_total_messages_per_window": 20,
            "max_new_orders_per_window": 10,
            "max_reduce_orders_per_window": 10,
            "max_cancel_messages_per_window": 20,
            "reserved_risk_messages_per_window": 5,
            "reserved_cancel_messages_per_window": 5
        },
        "self_trade_prevention": {
            "enabled": true,
            "local_cross_check": true,
            "exchange_mode": "EXPIRE_MAKER"
        },
        "single_writer_fence": {
            "enabled": true,
            "path": "storage/paper/oms_journal.jsonl.lock"
        },
        "venue_dead_man_switch": {
            "enabled": false,
            "countdown_time_ms": 120000,
            "renewal_interval_sec": 30.0,
            "max_renewal_age_sec": 45.0,
            "recovery_checks": 2
        },
        "truth_monitor": {
            "poll_interval_sec": 5.0,
            "api_freeze_threshold": 2,
            "api_halt_threshold": 4,
            "account_balance_tolerance": 1.0,
            "testnet_account_balance_tolerance": 5.0,
            "balance_drift_trigger_count": 3,
            "ignore_flat_balance_drift": true,
            "clean_polls_to_clear": 2
        }
    },

    "risk": {
        "active": true,
        "limits": {
            "max_order_qty": 10000.0,
            "max_order_notional": 12.0,
            "max_pos_notional": 18.0,
            "max_account_gross_notional": 36.0,
            "max_daily_loss": 4.0,
            "max_drawdown_pct": 0.05
        },
        "strategy_risk_budgets": {
            "enabled": true,
            "require_explicit_strategy": true,
            "budgets": {
                "GLFT_MultiScale": {
                    "auto_scale": true,
                    "max_gross_notional": 36.0,
                    "max_symbol_notional": 18.0
                }
            }
        },
        "price_sanity": {
            "max_deviation_pct": 0.02,
            "max_spread_pct": 0.01
        },
        "market_data_freshness": {
            "enabled": true,
            "require_mark_price": true,
            "require_book": true,
            "max_mark_age_ms": 3000,
            "max_book_age_ms": 1500,
            "poll_interval_sec": 0.25,
            "breach_checks": 2,
            "recovery_checks": 5
        },
        "cash_flow_truth": {
            "enabled": false,
            "require_snapshot": false,
            "max_snapshot_age_sec": 45,
            "poll_interval_sec": 30,
            "recovery_checks": 2,
            "external_income_types": ["TRANSFER"]
        },
        "risk_control_heartbeat": {
            "enabled": true,
            "max_age_sec": 2.0,
            "required_source": "risk_manager"
        },
        "independent_supervisor": {
            "enabled": false,
            "heartbeat_interval_sec": 0.25,
            "parent_heartbeat_timeout_sec": 1.5,
            "status_max_age_sec": 2.0,
            "exchange_poll_interval_sec": 5.0,
            "exchange_max_age_sec": 10.0,
            "cancel_retry_sec": 2.0,
            "orphan_exit_sec": 30.0,
            "stop_timeout_sec": 10.0,
            "emergency_countdown_time_ms": 1000,
            "recovery_checks": 2,
            "gross_kill_multiplier": 1.25,
            "flatten_enabled": false,
            "parent_loss_flatten_delay_sec": 3.0,
            "flatten_retry_sec": 2.0,
            "flat_verification_checks": 2,
            "state_path": "storage/risk/independent_supervisor_state.json",
            "state_required": true,
            "state_fsync": true,
            "rearm_prepare_ttl_sec": 10.0,
            "rearm_command_timeout_sec": 5.0,
            "daily_loss_enabled": false,
            "daily_loss_reduce_only_fraction": 0.80,
            "cash_flow_income_types": ["TRANSFER"],
            "cash_flow_assets": ["USDT", "USDC", "BUSD", "FDUSD"],
            "cash_flow_max_pages": 5,
            "clock_sync_enabled": true,
            "clock_sync_interval_sec": 10.0,
            "clock_sample_count": 5,
            "clock_min_successful_samples": 3,
            "clock_low_rtt_sample_count": 3,
            "clock_sample_spacing_ms": 10.0,
            "clock_max_initial_offset_ms": 5000.0,
            "clock_reduce_only_phase_error_ms": 25.0,
            "clock_kill_phase_error_ms": 100.0,
            "clock_max_rtt_ms": 200.0,
            "clock_max_uncertainty_ms": 50.0,
            "clock_max_offset_dispersion_ms": 10.0,
            "clock_max_wall_step_ms": 20.0,
            "liquidation_proximity_enabled": true,
            "require_liquidation_price": true,
            "liquidation_reduce_only_distance_pct": 0.05,
            "liquidation_kill_distance_pct": 0.02
        },
        "margin_health": {
            "enabled": true,
            "require_snapshot": true,
            "degraded_ratio": 0.50,
            "reduce_only_ratio": 0.70,
            "kill_ratio": 0.90,
            "recovery_ratio": 0.40,
            "max_snapshot_age_sec": 15,
            "recovery_checks": 3
        },
        "tech_health": {
            "max_latency_ms": 500,
            "max_order_count_per_sec": 20,
            "consecutive_error_limit": 5
        },
        "black_swan": {
            "volatility_halt_threshold": 0.02
        }
    },
    "backtest": {
        "initial_capital": 100.0,
        "taker_fee": 0.0005,
        "maker_fee": 0.0002,
        "_comment_rpi_commission_rate": "Final RPI route rate from GET /fapi/v1/commissionRate; it replaces maker_fee for RPI fills and is never hardcoded.",
        "rpi_commission_rate": 0.0,
        "rpi_commission_rates": {},
        "latency_ms_mean": 20,
        "latency_ms_std": 5,
        "cancel_ahead_prob": 0.5
    },
    "chaos": {
        "packet_loss_rate": 0.0,
        "order_reject_rate": 0.0
    },
    "strategy": {
        "name": "GLFT_MultiScale",
        "primary_model": "glft",
        "registered_models": [
            "glft",
            "avellaneda_stoikov"
        ],
        "execution_policy": "single_primary",
        "_comment_model_policy": "All models are selectable, but exactly one primary owns order submission. Change primary_model and restart to switch; automatic failover is not enabled.",
        "_comment_rpi": "Live startup requires every configured symbol to expose RPI permission and account-specific commission truth.",
        "use_rpi": false,
        "use_rpi_for_avellaneda_stoikov": true,
        "use_rpi_for_glft": true,
        "rpi_fallback_to_gtx": false,
        "rpi_live_policy": {
            "require_zero_commission": false
        },
        "_comment_capital_scaling": "Only change capital_multiplier. Order notional and caps scale together.",
        "capital_multiplier": 1.0,
        "capital_scaling": {
            "enabled": true,
            "reference_capital_usdt": 100.0,
            "target_order_notional": 8.0,
            "_comment_order_notional_limit_factor": "Allows modest size-up without letting validator block every strong signal.",
            "order_notional_limit_factor": 1.5,
            "target_total_risk_notional": 36.0,
            "target_concurrent_symbols": 2,
            "target_daily_loss": 4.0,
            "max_order_qty": 10000.0,
            "_comment_budget_asset_weights": "When symbols span both USDT and USDC, use weights to decide how the trading budget is split.",
            "budget_asset_weights": {
                "USDT": 1.0
            },
            "position_buffer_orders": 2.0,
            "reference_min_notional": 5.0,
            "notional_buffer": 1.1
        },
        "model_readiness": {
            "_comment": "Paper collects samples in OBSERVE_ONLY until each symbol is ready. Live additionally requires hashed genuine-RPI exposure and OOS evidence; live approval remains intentionally disabled.",
            "enabled": true,
            "min_volatility_samples": 50,
            "min_model_samples": 30,
            "models": {
                "glft": {
                    "min_volatility_samples": 50,
                    "min_model_samples": 30
                },
                "avellaneda_stoikov": {
                    "min_volatility_samples": 50,
                    "min_model_samples": 60
                }
            },
            "live_approval": {
                "manifest_path": "",
                "min_data_duration_sec": 604800,
                "min_oos_samples": 10000
            }
        },
        "lot_multiplier": 0.18181818,
        "spread_ratio": 0.0005,
        "skew_factor_usdt": 50.0,
        "max_pos_usdt": 18.0,
        "glft": {
            "_comment": "Paper uses configured A/k only as a labeled proxy. Live ignores public aggTrade and requires a hashed LIVE_BINANCE_RPI_ACK exposure artifact.",
            "gamma": 0.1,
            "cycle_interval": 1.0,
            "alpha": {
                "enabled": false
            },
            "target_inventory_notional_usdt": 0.0,
            "inventory_lot_notional_usdt": 8.0,
            "rpi_intensity": {
                "depth_bin_width_bps": 0.25,
                "max_initial_book_age_seconds": 1.5,
                "max_runtime_parameter_ratio": 3.0,
                "min_sample_count": 30,
                "min_depth_level_count": 3,
                "min_total_exposure_seconds": 60.0,
                "min_fill_count": 10,
                "min_depth_span_bps": 0.5,
                "min_k_per_bps": 0.000001,
                "max_k_per_bps": 100.0
            },
            "calibrator": {
                "window": 1000,
                "min_samples": 50,
                "initial_sigma_bps": 10.0,
                "initial_A": 10.0,
                "initial_k": 0.8,
                "learning_rate": 0.005,
                "sigma_max_bps": 100.0,
                "sigma_ema_alpha": 0.1,
                "max_tick_gap_sec": 2.0
            },
            "execution": {
                "min_spread_bps": 5.0
            }
        },
        "avellaneda_stoikov": {
            "_comment": "Registered explanatory baseline and manually selected fallback; not a concurrent execution strategy.",
            "gamma": 0.05,
            "k": 1.5,
            "vol_window": 60,
            "cycle_interval": 1.0,
            "horizon_s": 1.0,
            "min_sigma_bps": 0.1,
            "max_tick_gap_sec": 2.0,
            "inventory_lot_notional_usdt": 8.0,
            "min_spread_ratio": 0.0002
        }
    }
}
