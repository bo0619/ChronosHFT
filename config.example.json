            "renewal_interval_sec": 30.0,
            "max_renewal_age_sec": 45.0,
            "recovery_checks": 2
        },
        "truth_monitor": {
            "poll_interval_sec": 5.0,
            "api_freeze_threshold": 2,
            "api_halt_threshold": 4,
