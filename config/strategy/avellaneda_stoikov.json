{
  "$schema": "chronoshft.config_fragment.v3",
  "fragment": "strategy.avellaneda_stoikov",
  "version": 1,
  "strategy": {
    "avellaneda_stoikov": {
      "_comment": "Registered Paper alternative; not concurrent with GLFT. Adaptive A-S uses a configured A proxy only for size because A cancels from the optimal-price condition.",
      "gamma": 0.05,
      "k": 1.5,
      "vol_window": 60,
      "cycle_interval": 1.0,
      "horizon_s": 1.0,
      "min_sigma_bps": 0.1,
      "max_tick_gap_sec": 2.0,
      "min_spread_ratio": 0.0002,
      "portfolio_risk": {
        "enabled": true,
        "require_full_universe": true,
        "max_state_age_sec": 5.0,
        "correlations": {}
      },
      "adaptive": {
        "enabled": true,
        "side_intensity": {
          "base_A_per_s": 10.0,
          "bid_A_multiplier": 1.0,
          "ask_A_multiplier": 1.0,
          "bid_k_multiplier": 1.0,
          "ask_k_multiplier": 1.0
        },
        "hawkes": {
          "decay_rate_per_s": 2.0,
          "self_excitation": 0.12,
          "cross_excitation": 0.03,
          "max_multiplier": 3.0
        },
        "markout": {
          "horizons_ms": [100, 500, 1000],
          "min_samples": 12,
          "confidence_z": 1.645,
          "max_pending": 5000,
          "window_size": 200
        },
        "flow_toxicity": {
          "enabled": true,
          "half_life_s": 0.75,
          "ewma_alpha": 0.2,
          "trade_imbalance_cost_bps": 2.0,
          "microprice_weight": 1.0,
          "max_adverse_cost_bps": 3.0
        },
        "stale_quote_guard": {
          "enabled": true,
          "min_depth_bps": 1.5
        },
        "dynamic_covariance": {
          "sample_interval_s": 1.0,
          "max_state_age_s": 3.0,
          "max_sync_skew_s": 0.25,
          "ewma_alpha": 0.05,
          "diagonal_shrinkage": 0.15,
          "min_samples": 30
        },
        "robust": {
          "k_ratio": 1.25,
          "volatility_ratio": 1.2
        },
        "queue_latency": {
          "rate_ewma_alpha": 0.15,
          "default_service_rate_qty_per_s": 1.0,
          "max_queue_delay_s": 5.0,
          "network_latency_ms": 30.0,
          "queue_risk_time_weight": 0.02,
          "confidence_z": 1.0
        },
        "size_optimization": {
          "candidate_multipliers": [0.0, 0.25, 0.5, 1.0],
          "utility_horizon_s": 1.0,
          "size_penalty_bps": 0.05
        }
      }
    }
  }
}
