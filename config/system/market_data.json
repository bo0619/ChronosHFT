{
  "$schema": "chronoshft.config_fragment.v3",
  "fragment": "system.market_data",
  "version": 1,
  "system": {
    "market_data": {
      "_comment": "Reject stale Binance public events at ingress and reconnect before delayed batches can poison caches, paper matching, or symbol circuit breakers.",
      "environment": "production",
      "testnet": false,
      "public_only": true,
      "publish_depth_levels": 5,
      "emit_full_orderbook_events": false,
      "max_book_buffer": 2048,
      "max_orderbook_levels_per_side": 4096,
      "max_delta_levels_per_side": 2048,
      "max_book_recovery_threads": 4,
      "book_recovery_join_timeout_sec": 3.0,
      "book_resync_max_attempts": 3,
      "book_resync_retry_sec": 0.25,
      "stream_ready_timeout_sec": 10.0,
      "max_market_event_ingress_age_ms": 1200.0
    }
  }
}
