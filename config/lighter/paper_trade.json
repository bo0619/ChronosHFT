{
  "$schema": "chronoshft.config_fragment.v3",
  "fragment": "paper_trade",
  "version": 1,
  "paper_trade": {
    "maker_fee": 0.0,
    "taker_fee": 0.0,
    "rpi_commission_rate": 0.0,
    "rpi_commission_rates": {},
    "rpi_fill_model": "public_trade_proxy",
    "reset_on_start": true,
    "cancel_ahead_fraction": 0.0,
    "maintenance_margin_rate": 0.005,
    "mark_rest_poll_interval_sec": 0.25,
    "mark_ws_stale_after_sec": 1.5,
    "mark_rest_request_timeout_sec": 0.75,
    "command_timeout_sec": 2.0,
    "command_queue_size": 4096,
    "max_order_history": 10000,
    "max_trade_history": 20000,
    "maker_order_delay_ms": 200,
    "taker_order_delay_ms": 300,
    "_comment_fees": "Lighter Standard accounts pay 0 maker / 0 taker but every order waits in a speed bump before matching: 200ms for maker orders, 300ms for taker orders. Premium accounts pay fees with a shorter speed bump; set both here."
