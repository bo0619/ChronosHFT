# .gitignore

# 1. 忽略 Python 编译缓存 (垃圾文件)
__pycache__/
*.py[cod]
.tmp/

# 2. [绝对禁止上传] 配置文件 (含 API Key)
config.live.canary.json
config.live.rpi-calibration.json
config.live.rpi-calibration.permit.json
config.live.canary.evidence.json
config/local/
*.pem
*.key

# 3. 忽略回测产生的庞大某些数据
storage/
!storage/.gitkeep  # 保留文件夹结构(可选)

# 4. 忽略 VS Code 配置
.vscode/

# 5. 忽略虚拟环境
.venv/
.tools/
.uv-cache/

# 6. 忽略日志文件
logs/

# 7. 忽略测试文件
*.ps1
tests/
!tests/
tests/*
!tests/test_oms_institutional_recovery.py
!tests/test_oms_durable_ledger.py
